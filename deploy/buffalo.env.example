# BUFFALO installation settings (Phase 9A). Copy to /etc/buffalo/buffalo.env
# (mode 0640, root). Settings only: secrets live as files in
# BUFFALO_SECRETS_DIR (scripts/ops/generate-secrets.sh), never here.
#
# Used twice: by Docker Compose for the deployment (the BUFFALO_* and
# COMPOSE_* lines) and by the application containers (everything else).

# --- Deployment (Compose) ---------------------------------------------------
COMPOSE_PROJECT_NAME=buffalo
# Written by install.sh from the chosen profile and options.
COMPOSE_FILE=compose.yml:compose.prod.yml:compose.profile-airgapped.yml
BUFFALO_VERSION=0.0.0
BUFFALO_PROFILE=airgapped
BUFFALO_SECRETS_DIR=/etc/buffalo/secrets
BUFFALO_CONFIG=/etc/buffalo/buffalo.env
# The public host name (TLS certificate subject) and certificate file.
BUFFALO_SERVER_NAME=buffalo.example.gov.ng
BUFFALO_TLS_CERTIFICATE_FILE=/etc/buffalo/tls/fullchain.pem
BUFFALO_BIND_ADDRESS=0.0.0.0
BUFFALO_HTTP_PORT=80
BUFFALO_HTTPS_PORT=443
# Registry pulls (connected/cloud): e.g. registry.example.gov.ng/buffalo
BUFFALO_IMAGE_PREFIX=buffalo
# ACME (compose.acme.yml only)
ACME_EMAIL=
ACME_SERVER=

# --- Application --------------------------------------------------------------
APP_NAME=BUFFALO
APP_URL=https://buffalo.example.gov.ng
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=buffalo
DB_USERNAME=buffalo_app
DB_MIGRATIONS_USERNAME=buffalo_owner
DB_READONLY_USERNAME=buffalo_readonly
# The cluster superuser (provisioning only).
DB_ADMIN_USERNAME=buffalo

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_USERNAME=buffalo

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# Mail: off unless an SMTP relay is reachable (internal relay, or the
# egress overlay compose.egress-mail.yml in connected/cloud).
BUFFALO_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_FROM_ADDRESS=buffalo@example.gov.ng
MAIL_FROM_NAME=BUFFALO

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=buffalo
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=buffalo.example.gov.ng

GOTENBERG_URL=http://gotenberg:3000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
BUFFALO_CSP_REPORT_ONLY=false

# Backups (repository 2: a separate disk, NFS mount or removable media).
BACKUP_PG_RETENTION_FULL=4
BACKUP_EVIDENCE_KEEP_DAILY=14
BACKUP_EVIDENCE_KEEP_WEEKLY=8
BACKUP_EVIDENCE_KEEP_MONTHLY=12
BACKUP_REPO2_ENABLED=false
BACKUP_REPO2_PATH=

# --- Capacity (docs/operations/sizing.md) ---------------------------------
# Container limits: BUFFALO_MEM_<SERVICE> / BUFFALO_CPUS_<SERVICE>, e.g.
# BUFFALO_MEM_POSTGRES=3g
# PostgreSQL memory (keep shared_buffers about 25% of BUFFALO_MEM_POSTGRES):
# BUFFALO_PG_SHARED_BUFFERS=768MB
# BUFFALO_PG_EFFECTIVE_CACHE_SIZE=2GB
# BUFFALO_PG_WORK_MEM=16MB
# BUFFALO_PG_MAINTENANCE_WORK_MEM=256MB
