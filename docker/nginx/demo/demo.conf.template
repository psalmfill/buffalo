# BUFFALO UAT demo server (UAT only; mounted by compose.uat-demo.yml, never
# part of a production deployment). Plain HTTP on 8081, published on the
# host's 127.0.0.1:$DEMO_PORT only, behind a host-level nginx that
# terminates TLS for $DEMO_HOST (docs/operations/demo-hosting.md).
#
# X-Forwarded-For and X-Forwarded-Proto are honoured ONLY from the Docker
# gateway address (BUFFALO_DEMO_GATEWAY, found at start by
# 15-buffalo-demo-gateway.envsh): connections to the published port arrive
# from it. From any other peer the headers are ignored, and PHP never
# trusts them itself (Laravel trusts no proxies).

# The peer as seen before real_ip: the gateway, or anything else.
geo $realip_remote_addr $buffalo_from_demo_proxy {
    default 0;
    ${BUFFALO_DEMO_GATEWAY}/32 1;
}

map "$buffalo_from_demo_proxy:$http_x_forwarded_proto" $buffalo_demo_https {
    "1:https" on;
    default "";
}

server {
    listen 8081 default_server;
    listen [::]:8081 default_server;
    server_name _;

    # The browser's address replaces the gateway's in logs, the internal
    # allow-lists (/health/detailed) and PHP's REMOTE_ADDR: the last
    # X-Forwarded-For entry, the one the host proxy appended.
    set_real_ip_from ${BUFFALO_DEMO_GATEWAY}/32;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    include /etc/nginx/buffalo/app.conf;

    # After the include: HTTPS as forwarded by the trusted proxy.
    if ($buffalo_demo_https) {
        set $buffalo_https on;
    }
}
