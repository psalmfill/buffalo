#!/bin/sh
# UAT demo only (mounted by compose.uat-demo.yml). Sourced by the nginx
# image's entrypoint before the templates are rendered: exports
# BUFFALO_DEMO_GATEWAY, the only peer whose X-Forwarded-* headers the demo
# server honours.
#
# nginx's only network with a gateway is `frontend` (backend is internal),
# so the container's default route is that network's gateway: the address
# Docker's port publishing connects from. Set BUFFALO_DEMO_GATEWAY to
# override (e.g. a host whose port publishing works differently).
if [ -z "${BUFFALO_DEMO_GATEWAY:-}" ]; then
    BUFFALO_DEMO_GATEWAY=$(awk '$2 == "00000000" {
        hex = "0123456789ABCDEF"; g = toupper($3); ip = ""
        for (i = 7; i >= 1; i -= 2) {
            n = (index(hex, substr(g, i, 1)) - 1) * 16 + index(hex, substr(g, i + 1, 1)) - 1
            ip = ip (i < 7 ? "." : "") n
        }
        print ip; exit
    }' /proc/net/route)
fi

if [ -z "$BUFFALO_DEMO_GATEWAY" ]; then
    # Fail closed: no peer is trusted (TEST-NET-1, never a real peer).
    BUFFALO_DEMO_GATEWAY=192.0.2.1
    echo "15-buffalo-demo-gateway: no default gateway found; forwarded headers will not be trusted" >&2
fi

export BUFFALO_DEMO_GATEWAY
echo "15-buffalo-demo-gateway: trusting X-Forwarded-* from $BUFFALO_DEMO_GATEWAY" >&2
