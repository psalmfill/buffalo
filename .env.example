# -----------------------------------------------------------------------------
# BUFFALO environment. Copy to .env (`make setup` does this for you).
# Defaults are for local development with Docker Compose. Never commit .env.
# -----------------------------------------------------------------------------

APP_NAME=BUFFALO
APP_ENV=local
# Generated by `make setup` (php artisan key:generate).
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Field encryption key for sensitive person data (NIN, phone, date of birth,
# address), spatie/laravel-ciphersweet. Generated once by `make setup`.
# LOSING THIS KEY MAKES ALL ENCRYPTED PERSON DATA UNRECOVERABLE. Back it up
# separately from the database and never commit it. Never regenerate it for
# an existing database. See docs/security/encryption-keys.md.
CIPHERSWEET_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------
# Host ports. All are bound to 127.0.0.1 only (see compose.override.yml).
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_VALKEY_PORT=6379
FORWARD_MAILPIT_UI_PORT=8025
VITE_PORT=5173

# UID/GID the containers run as. The Makefile sets these from `id -u` and
# `id -g`; only set them here if you run `docker compose` directly.
# DOCKER_UID=1000
# DOCKER_GID=1000

# Xdebug is installed in the dev image but off. Set to e.g. "debug" or
# "debug,develop" and run `make up` to enable it.
XDEBUG_MODE=off

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS (service "postgres"). These values also create the
# database and user the first time the postgres_data volume is initialised.
# Tests use the separate "buffalo_test" database (see phpunit.xml).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=buffalo
# Phase 8A: the application connects as buffalo_app (no DDL; audit tables
# are append-only); migrations run as buffalo_owner; the superuser is used
# only to create roles (buffalo:db:provision-roles) and in development tools.
DB_USERNAME=buffalo_app
DB_PASSWORD=buffalo-app-dev
DB_MIGRATIONS_USERNAME=buffalo_owner
DB_MIGRATIONS_PASSWORD=buffalo-owner-dev
DB_READONLY_USERNAME=buffalo_readonly
DB_READONLY_PASSWORD=buffalo-readonly-dev
DB_ADMIN_USERNAME=buffalo
DB_ADMIN_PASSWORD=buffalo

# -----------------------------------------------------------------------------
# Valkey (service "valkey"), used through Laravel's redis driver with phpredis
# for sessions, cache and queues.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
# Phase 8A: Valkey requires authentication (ACL user for the application;
# FLUSHALL/FLUSHDB/CONFIG/KEYS/DEBUG are blocked for it). The admin user is
# for operators only (for example `cache:clear`).
REDIS_USERNAME=buffalo
REDIS_PASSWORD=buffalo-valkey-dev
VALKEY_ADMIN_PASSWORD=buffalo-valkey-admin-dev
REDIS_PORT=6379

SESSION_DRIVER=redis
# Idle timeout (minutes). Users get a warning 2 minutes before it.
SESSION_LIFETIME=30
# Absolute maximum session age (hours), whatever the activity.
BUFFALO_SESSION_MAX_HOURS=12
# Sign out other sessions when an account signs in elsewhere.
BUFFALO_SINGLE_SESSION=true

# Optional banner at the top of every page, including sign-in. Leave the text
# empty for no banner. Level: info, restricted, confidential or secret.
BUFFALO_BANNER_TEXT=
BUFFALO_BANNER_LEVEL=info

# LGA chiefs are reminded weekly when their LGA profile has not been reviewed
# for this many days.
BUFFALO_PROFILE_REVIEW_DAYS=180

# Persons of interest are due for review this many months after being
# designated or last reviewed.
BUFFALO_POI_REVIEW_MONTHS=12
# Secure session cookie. Defaults to true when APP_URL is https://.
# SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# File storage. Evidence lives on the private evidence_data volume.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
EVIDENCE_ROOT=/var/lib/buffalo/evidence

# -----------------------------------------------------------------------------
# Mail: Mailpit (service "mailpit") catches all mail in development.
# UI: http://localhost:8025
# -----------------------------------------------------------------------------
# Whether BUFFALO sends email at all (setup links, 2FA reset notices,
# password resets, notification emails). Mailpit catches it in development.
BUFFALO_MAIL_ENABLED=true
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@buffalo.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Broadcasting: Laravel Reverb (service "reverb").
# Laravel publishes events to reverb:8080 inside the Docker network. Browsers
# connect through nginx (ws://localhost:8000/app/...), so the VITE_* values
# point at nginx, not at the reverb container.
# The app id/key/secret below are development-only values; generate new ones
# (php artisan reverb:install) for any other environment.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=100001
REVERB_APP_KEY=buffalo-dev-key
REVERB_APP_SECRET=buffalo-dev-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated hosts allowed to open WebSocket connections.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8000
VITE_REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"

# Reports (Phase 7D): Gotenberg on the internal reports network.
GOTENBERG_URL=http://gotenberg:3000
REPORTS_ROOT=/var/lib/buffalo/reports

# Phase 8B.4: malware scanning. clamd on the internal scanning network.
# Signatures update online only when CLAMAV_ONLINE_UPDATES=true; air-gapped
# servers import them with `make clamav-import-signatures`.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ONLINE_UPDATES=false
QUARANTINE_ROOT=/var/lib/buffalo/quarantine

# Phase 8B: Content Security Policy. true = report violations to /csp-report
# (storage/logs/csp-*.log) without blocking; false = enforce (default).
BUFFALO_CSP_REPORT_ONLY=false

# Phase 8C: backups. Encryption passphrases for the pgBackRest and restic
# repositories: long random values, escrowed WITH the keys (never with the
# backups). Production: supply as files (BACKUP_PGBACKREST_PASSPHRASE_FILE,
# BACKUP_RESTIC_PASSWORD_FILE). The development values below are refused
# when APP_ENV=production.
BACKUP_PGBACKREST_PASSPHRASE=buffalo-dev-backup-passphrase-do-not-use
BACKUP_RESTIC_PASSWORD=buffalo-dev-restic-password-do-not-use
BACKUP_PG_RETENTION_FULL=4
BACKUP_EVIDENCE_KEEP_DAILY=14
BACKUP_EVIDENCE_KEEP_WEEKLY=8
BACKUP_EVIDENCE_KEEP_MONTHLY=12
# Repository 2 (separate disk, NFS mount or removable media), set per
# deployment in Phase 9: BACKUP_REPO2_ENABLED=true and BACKUP_REPO2_PATH=/mnt/...
BACKUP_REPO2_ENABLED=false
BACKUP_REPO2_PATH=
