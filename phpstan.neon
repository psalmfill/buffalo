includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Access-logging infrastructure (Phase 1D) whose first production
        # users arrive in Phase 3; covered by tests/Feature/Audit.
        -
            identifier: trait.unused
            path: app/Models/Concerns/LogsReads.php
